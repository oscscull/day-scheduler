{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quarterdeck",
  "version": "0.1.0",
  "identifier": "com.oscscull.quarterdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Quarterdeck",
        "width": 1200,
        "height": 860,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyNzNCRkVGMjYwOTc3NzMKUldSemR3a203Nzl6QWhUZjhrelo4Vmx5VUZKY3RtOFA3eFl2akwvbUM4dW02YXAraEhKclFIVmYK",
      "endpoints": [
        "https://github.com/oscscull/quarterdeck/releases/latest/download/latest.json"
      ]
    }
  }
}
